# Copy this file to .env. Never commit a real API key.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_TIMEOUT_SECONDS=60

APP_ENV=development
LOG_LEVEL=INFO
ARTIFACTS_DIR=artifacts
CHECKPOINT_DB_PATH=data/checkpoints.db
BRAND_KNOWLEDGE_DB_PATH=data/brand_knowledge.db
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=6
POSTER_VARIANT_COUNT=3
POSTER_MAX_RENDER_ATTEMPTS=2
POSTER_QA_THRESHOLD=75
POSTER_GENERATION_SIZE=1088x1360
POSTER_GENERATION_QUALITY=high
DATABASE_URL=sqlite+aiosqlite:///./data/poster_agent.db

# Optional PostgreSQL settings for a later production deployment.
POSTGRES_DB=poster_agent
POSTGRES_USER=poster_agent
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
